<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bikevault.controller.CustomerPayController" spacing="12">
    <padding>
        <Insets top="18" right="24" bottom="18" left="24"/>
    </padding>
    <Label text="Payment" styleClass="customer-title"/>
    <VBox spacing="8" styleClass="trip-card" maxWidth="480">
        <Label fx:id="rentalLabel" wrapText="true"/>
        <Label text="Daily rate" styleClass="field-label"/>
        <Label fx:id="rateLabel"/>
        <Label text="Duration" styleClass="field-label"/>
        <Label fx:id="durationLabel"/>
        <Label text="Rental subtotal" styleClass="field-label"/>
        <Label fx:id="rentalAmountLabel" styleClass="bike-card-price"/>
        <Label text="Penalty" styleClass="field-label"/>
        <Label fx:id="penaltyLabel"/>
        <Label text="TOTAL" styleClass="customer-kicker"/>
        <Label fx:id="totalLabel" styleClass="bike-card-price"/>
        <Label text="Pay now to generate your unique rental QR. Admin still approves collection."
               wrapText="true" styleClass="customer-tagline"/>
        <Label text="Payment method" styleClass="field-label"/>
        <ComboBox fx:id="methodCombo" prefWidth="200"/>
        <Button text="PAY NOW" styleClass="primary-button" onAction="#onPay" prefWidth="160"/>
    </VBox>
</VBox>
