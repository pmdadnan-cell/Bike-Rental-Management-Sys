<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bikevault.controller.CustomerPassController"
            fitToWidth="true" focusTraversable="false" style="-fx-background: transparent;">
    <VBox spacing="16" alignment="TOP_CENTER">
        <padding>
            <Insets top="18" right="24" bottom="24" left="24"/>
        </padding>
        <Label text="Rental QR" styleClass="customer-title"/>
        <Label text="Show this pass to Admin. You do not scan a bike QR to rent."
               styleClass="customer-tagline" wrapText="true"/>
        <VBox fx:id="passCard" spacing="10" styleClass="rental-pass" alignment="CENTER" maxWidth="380">
            <ImageView fx:id="logoView" fitWidth="52" fitHeight="52"/>
            <Label text="BIKEVAULT" styleClass="pass-brand"/>
            <Label text="RENTAL PASS" styleClass="customer-kicker"/>
            <ImageView fx:id="qrView" fitWidth="280" fitHeight="280"/>
            <Label fx:id="statusBadge" text="WAITING FOR APPROVAL" styleClass="pass-status"/>
            <Label fx:id="passLabel" wrapText="true" styleClass="pass-body"/>
        </VBox>
        <HBox spacing="10" alignment="CENTER">
            <Button text="SHOW QR" styleClass="primary-button" onAction="#onShowQr"/>
            <Button text="VIEW TRIP" styleClass="secondary-button" onAction="#onViewTrip"/>
        </HBox>
        <Label fx:id="emptyHint" managed="false" visible="false" wrapText="true" styleClass="customer-tagline"/>
    </VBox>
</ScrollPane>
