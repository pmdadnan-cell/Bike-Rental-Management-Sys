<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bikevault.controller.IncidentController" spacing="10" styleClass="module-root">
    <padding>
        <Insets top="8" right="18" bottom="16" left="18"/>
    </padding>
    <Label text="Incident review" styleClass="panel-title"/>
    <TableView fx:id="table" prefHeight="280">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
            <TableColumn fx:id="customerColumn" text="Customer" prefWidth="160"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="150"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="120"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="280"/>
        </columns>
    </TableView>
    <TextArea fx:id="detailsArea" prefRowCount="4"/>
    <HBox spacing="8">
        <ComboBox fx:id="statusCombo" prefWidth="180"/>
        <Button text="Save review" styleClass="primary-button" onAction="#onReview"/>
    </HBox>
</VBox>
