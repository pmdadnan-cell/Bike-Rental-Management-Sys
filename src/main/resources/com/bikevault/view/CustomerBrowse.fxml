<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bikevault.controller.CustomerBrowseController" spacing="14">
    <padding>
        <Insets top="16" right="22" bottom="16" left="22"/>
    </padding>
    <Label text="Browse the fleet" styleClass="customer-title"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search bikes..." prefWidth="220"/>
        <ComboBox fx:id="categoryCombo" prefWidth="140"/>
        <ComboBox fx:id="availabilityCombo" prefWidth="140"/>
        <TextField fx:id="colorField" promptText="Color" prefWidth="110"/>
        <TextField fx:id="minField" promptText="Min ₹" prefWidth="80"/>
        <TextField fx:id="maxField" promptText="Max ₹" prefWidth="80"/>
        <Button text="Apply" styleClass="secondary-button" onAction="#refresh"/>
    </HBox>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="cardsPane" hgap="14" vgap="14">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8"/>
            </padding>
        </FlowPane>
    </ScrollPane>
</VBox>
