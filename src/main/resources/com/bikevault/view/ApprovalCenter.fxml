<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bikevault.controller.ApprovalCenterController"
            fitToWidth="true" focusTraversable="false">
    <VBox spacing="16" styleClass="module-root">
        <padding>
            <Insets top="12" right="18" bottom="16" left="18"/>
        </padding>
        <Label text="Approval Center" styleClass="section-title"/>
        <Label text="Scan a customer's rental QR to authorize collection or accept a return."
               wrapText="true" styleClass="muted-label"/>

        <VBox fx:id="scannerPane" spacing="12" alignment="CENTER" styleClass="scanner-hero">
            <Label text="SCAN RENTAL QR" styleClass="panel-title"/>
            <Label text="The same rental QR is used for collection and return."
                   wrapText="true" styleClass="muted-label"/>
            <VBox alignment="CENTER" styleClass="scanner-frame">
                <Label text="QR SCANNER AREA" styleClass="kicker-label"/>
                <Label text="Camera opens when you start the scan." styleClass="muted-label"/>
            </VBox>
            <HBox spacing="10" alignment="CENTER">
                <Button text="SCAN RENTAL QR" styleClass="success-button" onAction="#onScanRentalQr"/>
                <Button text="SCAN RETURN QR" styleClass="primary-button" onAction="#onScanReturnQr"/>
            </HBox>
        </VBox>

        <VBox fx:id="verifyPane" spacing="12" styleClass="verify-card" visible="false" managed="false">
            <Label fx:id="verifyTitle" text="RENTAL VERIFICATION" styleClass="panel-title"/>
            <Label fx:id="verifyBadge" text="✓ QR VERIFIED" styleClass="status-badge"/>
            <Label fx:id="verifyBody" wrapText="true" styleClass="muted-label"/>
            <HBox fx:id="collectionActions" spacing="8">
                <Button text="VIEW CUSTOMER" styleClass="ghost-button" onAction="#onViewCustomer"/>
                <Button text="VIEW BIKE" styleClass="ghost-button" onAction="#onViewBike"/>
                <Button fx:id="rejectButton" text="REJECT" styleClass="danger-button" onAction="#onReject"/>
                <Button fx:id="approveButton" text="APPROVE RENTAL" styleClass="success-button" onAction="#onApprove"/>
            </HBox>
            <HBox fx:id="returnActions" spacing="8" visible="false" managed="false">
                <Button text="VIEW CUSTOMER" styleClass="ghost-button" onAction="#onViewCustomer"/>
                <Button text="VIEW BIKE" styleClass="ghost-button" onAction="#onViewBike"/>
                <Button text="APPLY PENALTY" styleClass="secondary-button" onAction="#onApplyPenalty"/>
                <Button fx:id="rejectReturnButton" text="REJECT RETURN" styleClass="danger-button" onAction="#onRejectReturn"/>
                <Button fx:id="acceptReturnButton" text="ACCEPT RETURN" styleClass="success-button" onAction="#onAcceptReturn"/>
            </HBox>
            <HBox spacing="8">
                <Button text="SCAN RENTAL QR" styleClass="secondary-button" onAction="#onScanRentalQr"/>
                <Button text="SCAN RETURN QR" styleClass="secondary-button" onAction="#onScanReturnQr"/>
            </HBox>
        </VBox>

        <Label text="RECENT REQUESTS" styleClass="panel-title"/>
        <VBox fx:id="requestPane" spacing="12"/>
    </VBox>
</ScrollPane>
