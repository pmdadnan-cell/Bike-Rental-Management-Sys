<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bikevault.controller.RegisterController"
           styleClass="login-root"
           stylesheets="@../css/style.css">
    <VBox alignment="CENTER" spacing="12">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        <VBox styleClass="login-card" spacing="12" alignment="CENTER" maxWidth="520">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>
            <ImageView fx:id="logoView" fitWidth="56" fitHeight="56" preserveRatio="true"/>
            <Label text="CREATE ACCOUNT" styleClass="brand-title"/>
            <Label text="Join BIKEVAULT as a customer" styleClass="brand-subtitle"/>
            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <Label text="Username" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="usernameField" promptText="Choose a username" styleClass="input-field"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="Password" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <PasswordField fx:id="passwordField" promptText="At least 8 characters" styleClass="input-field"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Full name" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="nameField" styleClass="input-field" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label text="Email" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <TextField fx:id="emailField" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Phone" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="phoneField" styleClass="input-field" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <Label text="Driving license" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <TextField fx:id="licenseField" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                <Label text="Address" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6"
                       GridPane.columnSpan="2"/>
                <TextField fx:id="addressField" styleClass="input-field" GridPane.columnIndex="0" GridPane.rowIndex="7"
                           GridPane.columnSpan="2"/>
                <Label text="Date of birth" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <DatePicker fx:id="dobPicker" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                <Label text="Gender" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                <ComboBox fx:id="genderCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="9"/>
            </GridPane>
            <HBox spacing="10" alignment="CENTER">
                <Button text="REGISTER" styleClass="primary-button" onAction="#onRegister" prefWidth="140"/>
                <Button text="BACK TO LOGIN" styleClass="ghost-button" onAction="#onBack" prefWidth="160"/>
            </HBox>
            <Label fx:id="statusLabel" styleClass="login-status"/>
        </VBox>
    </VBox>
</StackPane>
