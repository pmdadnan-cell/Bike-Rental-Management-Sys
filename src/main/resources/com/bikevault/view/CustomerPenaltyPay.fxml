<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bikevault.controller.CustomerPenaltyPayController" spacing="14">
    <padding>
        <Insets top="18" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="PAY PENALTY" styleClass="customer-title"/>
    <Label text="Demo / simulated payment. No real bank transfer is sent."
           wrapText="true" styleClass="customer-tagline"/>
    <VBox spacing="8" styleClass="trip-card" maxWidth="420">
        <Label text="Penalty" styleClass="field-label"/>
        <Label fx:id="typeLabel"/>
        <Label text="Rental" styleClass="field-label"/>
        <Label fx:id="rentalLabel"/>
        <Label text="Bike" styleClass="field-label"/>
        <Label fx:id="bikeLabel"/>
        <Label text="Description" styleClass="field-label"/>
        <Label fx:id="descriptionLabel" wrapText="true"/>
        <Label text="Amount" styleClass="field-label"/>
        <Label fx:id="amountLabel" styleClass="bike-card-price"/>
        <Label text="Payment method" styleClass="field-label"/>
        <ComboBox fx:id="methodCombo" prefWidth="200"/>
        <Label fx:id="errorLabel" wrapText="true" styleClass="customer-tagline"/>
        <Button fx:id="payButton" text="PAY" styleClass="primary-button" onAction="#onPay" prefWidth="200"/>
        <Button text="BACK" styleClass="ghost-button" onAction="#onBack" prefWidth="140"/>
    </VBox>
</VBox>
